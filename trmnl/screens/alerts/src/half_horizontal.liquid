<div class="layout layout--col layout--stretch gap">
  <div class="item">
    <div class="meta">Alerts</div>
    <div class="content">
      <span class="value value--large">{{ total }}</span>
      {% if total == 0 %}
        <span class="label label--success">All clear &#10003;</span>
      {% endif %}
    </div>
  </div>
  {% if total > 0 %}
    <div class="hr"></div>
    <div class="col col--start gap">
      {% for item in items limit: 3 %}
        <div class="item">
          <div class="meta">
            <span class="label">{{ item.kind }}</span>
            <span class="label">{{ item.age }}</span>
          </div>
          <div class="content">
            <span class="label">{{ item.subject }} — {{ item.message }}</span>
          </div>
        </div>
      {% endfor %}
      {% assign overflow = total | minus: 3 %}
      {% if overflow > 0 %}
        <div class="item">
          <div class="content">
            <span class="label">+{{ overflow }} more</span>
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Synapse Alerts</span>
</div>
