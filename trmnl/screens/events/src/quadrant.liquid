<div class="layout layout--col layout--stretch gap">
  <div class="item">
    <div class="meta">Events</div>
    <div class="content">
      <span class="value value--small">drift {{ drift_count }}</span>
    </div>
  </div>
  {% if items.size == 0 %}
    <div class="item">
      <div class="content">
        <span class="label">No events</span>
      </div>
    </div>
  {% else %}
    {% for item in items limit: 1 %}
      <div class="item">
        <div class="meta">
          <span class="label">{{ item.kind }}</span>
          <span class="label">{{ item.age }}</span>
        </div>
        <div class="content">
          <span class="label">{{ item.subject }}</span>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Synapse Events</span>
</div>
