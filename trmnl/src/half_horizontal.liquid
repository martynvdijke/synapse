<div class="columns layout--stretch">
  <div class="column">
    <div class="grid grid--cols-3 gap">
      <div class="item">
        <div class="meta">Mon</div>
        <div class="content">
          <span class="value">{{ monitor_count }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta">Svc</div>
        <div class="content">
          <span class="value">{{ docker_count }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta">Prx</div>
        <div class="content">
          <span class="value">{{ npm_count }}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="column">
    <div class="col col--start gap">
      <div class="item">
        <div class="meta">Docker</div>
        <div class="content">
          {% if docker_ok %}
            <span class="label label--success">OK</span>
          {% else %}
            <span class="label label--error">ERR</span>
          {% endif %}
        </div>
      </div>
      <div class="item">
        <div class="meta">NPM</div>
        <div class="content">
          {% if npm_ok %}
            <span class="label label--success">OK</span>
          {% else %}
            <span class="label label--error">ERR</span>
          {% endif %}
        </div>
      </div>
      <div class="item">
        <div class="meta">Kuma</div>
        <div class="content">
          {% if kuma_ok %}
            <span class="label label--success">OK</span>
          {% else %}
            <span class="label label--error">ERR</span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Synapse</span>
</div>
