<div class="layout layout--col layout--stretch gap">
  <div class="col col--start gap">
    <div class="grid grid--cols-3 gap">
      <div class="item">
        <div class="meta">Monitors</div>
        <div class="content">
          <span class="value value--medium">{{ monitor_count }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta">Services</div>
        <div class="content">
          <span class="value value--medium">{{ docker_count }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta">Proxies</div>
        <div class="content">
          <span class="value value--medium">{{ npm_count }}</span>
        </div>
      </div>
    </div>
    <div class="item">
      <div class="meta">Health</div>
      <div class="content">
        <span class="label">
          D:{% if docker_ok %}OK{% else %}ERR{% endif %}
          N:{% if npm_ok %}OK{% else %}ERR{% endif %}
          K:{% if kuma_ok %}OK{% else %}ERR{% endif %}
        </span>
      </div>
    </div>
    <div class="item">
      <div class="meta">Up / Down</div>
      <div class="content">
        <span class="label">{{ up }} / {{ down }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Synapse</span>
</div>
