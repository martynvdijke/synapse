<div class="layout layout--col layout--stretch gap">
  <div class="grid grid--cols-1">
    <div class="item">
      <div class="meta">Monitors</div>
      <div class="content">
        <span class="value value--large">{{ monitor_count }}</span>
      </div>
    </div>
  </div>
  <div class="item">
    <div class="content">
      <span class="label">
        {% if up > 0 %}
          {{ up }} up / {{ down }} down
        {% else %}
          {% if kuma_ok %}All systems OK{% else %}Kuma error{% endif %}
        {% endif %}
      </span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Synapse</span>
</div>
